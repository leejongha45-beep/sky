# LLVM 23.1.0. Read compile commands from the project build configuration.
# Full selected checks are run separately through clang-tidy.
CompileFlags:
  CompilationDatabase: build/debug-O0

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Includes:
    AnalyzeAngledIncludes: true
  ClangTidy:
    FastCheckFilter: Strict
---
If:
  PathMatch: src/lib/io/net/private/socket\.cpp
Diagnostics:
  Includes:
    # glibc exposes these declarations through <poll.h> and <sys/socket.h>.
    IgnoreHeader: ['(^|/)sys/poll[.]h$', '(^|/)asm-generic/socket[.]h$']
---
If:
  PathMatch: src/lib/parallel/public/thread[.]hpp
Diagnostics:
  Includes:
    # glibc exposes these types through <pthread.h> and <signal.h>.
    IgnoreHeader: ['(^|/)bits/pthreadtypes[.]h$', '(^|/)bits/types/sigset_t[.]h$']
---
If:
  PathMatch: src/lib/parallel/private/thread[.]cpp
Diagnostics:
  Includes:
    # glibc exposes these types through <sched.h> and <signal.h>.
    IgnoreHeader: ['(^|/)bits/types/(struct_sched_param|sigset_t)[.]h$']
---
If:
  PathMatch: 'src/lib/parallel/(public/mutex[.]hpp|private/mutex[.]cpp)'
Diagnostics:
  Includes:
    # glibc exposes pthread_mutex_t and pthread_mutexattr_t through <pthread.h>.
    IgnoreHeader: ['(^|/)bits/pthreadtypes[.]h$']
